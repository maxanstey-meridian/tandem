<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>Meridian.Tandem.Ledger</PackageId>
        <Title>Tandem Ledger</Title>
        <Description>Typed durable product records for Tandem pipelines.</Description>
        <PackageTags>agents;ai;pipeline;sqlite</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/tandem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/tandem.git</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.SourceLink.GitHub"
            Version="8.0.0"
            PrivateAssets="all"
        />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tandem\Tandem.csproj" />
        <InternalsVisibleTo Include="Tandem.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
