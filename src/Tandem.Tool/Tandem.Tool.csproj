<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="OpenAI" Version="2.12.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.0" />
        <PackageReference Include="System.ClientModel" Version="1.14.0" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tandem\Tandem.csproj" />
        <ProjectReference Include="..\Tandem.Delivery\Tandem.Delivery.csproj" />
        <ProjectReference Include="..\Tandem.Ledger\Tandem.Ledger.csproj" />
        <ProjectReference Include="..\Tandem.Terminal\Tandem.Terminal.csproj" />
        <InternalsVisibleTo Include="Tandem.Tests" />
    </ItemGroup>
</Project>
