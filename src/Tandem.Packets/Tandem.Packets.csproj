<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>Meridian.Tandem.Packets</PackageId>
        <Title>Tandem Packets</Title>
        <Description>Strict typed Markdown packet-file input for Tandem applications.</Description>
        <PackageTags>agents;ai;packet;markdown;yaml</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/tandem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/tandem.git</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.SourceLink.GitHub"
            Version="8.0.0"
            PrivateAssets="all"
        />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Tandem.Packets.Tests" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
