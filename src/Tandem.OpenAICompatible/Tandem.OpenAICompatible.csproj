<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>Tandem.OpenAICompatible</PackageId>
        <Title>Tandem OpenAI-Compatible</Title>
        <Description>Optional provider normalization for OpenAI-compatible Tandem clients.</Description>
        <PackageTags>agents;ai;openai;openrouter;reasoning</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/tandem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/tandem.git</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="OpenAI" Version="2.12.0" />
        <PackageReference Include="System.ClientModel" Version="1.14.0" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Tandem.Tests" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
