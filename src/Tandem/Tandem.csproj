<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>Meridian.Tandem</PackageId>
        <Title>Tandem</Title>
        <Description>Typed in-process agentic pipelines built on Microsoft Agent Framework.</Description>
        <PackageTags>agents;ai;workflow;pipeline</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/tandem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/tandem.git</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.SourceLink.GitHub"
            Version="8.0.0"
            PrivateAssets="all"
        />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="JsonSchema.Net.Generation" Version="7.3.11" />
        <PackageReference Include="Microsoft.Agents.AI" Version="1.16.0" />
        <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.16.0" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\Tandem.Generators\Tandem.Generators.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <InternalsVisibleTo Include="Tandem.Tests" />
        <InternalsVisibleTo Include="Tandem.Advanced" />
        <InternalsVisibleTo Include="Tandem.Ledger" />
        <InternalsVisibleTo Include="Tandem.NodeApiSpike.Bridge" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
