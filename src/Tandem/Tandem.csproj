<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="Dunet" Version="1.16.2" />
        <PackageReference
            Include="Microsoft.Agents.AI.DurableTask"
            Version="1.16.0-preview.260730.1"
        />
        <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.16.0" />
        <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.16.0" />
        <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" Version="1.18.0" />
        <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.18.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
        <PackageReference Include="OpenAI" Version="2.12.0" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="System.CommandLine" Version="2.0.0" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\Tandem.Generators\Tandem.Generators.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
        <InternalsVisibleTo Include="Tandem.Tests" />
        <InternalsVisibleTo Include="Tandem.Tool" />
        <EmbeddedResource Include="../../TANDEM.md" LogicalName="Tandem.TANDEM.md" />
    </ItemGroup>
</Project>
