<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Every project under src/ is a package; its public surface is tracked in PublicAPI.*.txt. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <!-- RS0026/RS0027 guard binary compatibility across releases; Tandem breaks APIs outright. -->
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference
            Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
            Version="5.6.0"
            PrivateAssets="all"
        />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
