<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>Tandem.Advanced</PackageId>
        <Title>Tandem Advanced</Title>
        <Description>Advanced authoring policies and custom operation contracts for Tandem pipelines.</Description>
        <PackageTags>agents;ai;workflow;pipeline</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/maxanstey-meridian/tandem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/maxanstey-meridian/tandem.git</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.16.0" />
        <PackageReference
            Include="Microsoft.Agents.AI.Tools.Shell"
            Version="1.16.0-preview.260730.1"
        />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
        <PackageReference Include="Tavily" Version="1.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Tandem\Tandem.csproj" />
        <InternalsVisibleTo Include="Tandem.Tests" />
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
