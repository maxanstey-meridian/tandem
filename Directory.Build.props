<Project>
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <Authors>Max Anstey</Authors>
        <Company>Meridian</Company>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Local builds only: the release and publish workflows pass the tag as -p:Version. -->
        <VersionPrefix>0.3.1</VersionPrefix>
        <VersionSuffix></VersionSuffix>
        <!-- Only the projects under src/ are packages (src/Directory.Build.props). -->
        <IsPackable>false</IsPackable>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <ItemGroup>
        <SourceLinkGitHubHost
            Include="github-meridian"
            ContentUrl="https://raw.githubusercontent.com"
        />
    </ItemGroup>
</Project>
