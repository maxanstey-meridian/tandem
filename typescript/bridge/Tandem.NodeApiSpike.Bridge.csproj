<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <NodeApiTypedefsGeneratorOptions>--nowarn</NodeApiTypedefsGeneratorOptions>
        <TandemVersion Condition="'$(TandemVersion)' == ''">0.1.0</TandemVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.JavaScript.NodeApi" Version="0.9.26" />
        <PackageReference Include="Microsoft.JavaScript.NodeApi.Generator" Version="0.9.26" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
        <PackageReference Include="OpenAI" Version="2.12.0" />
        <PackageReference Include="System.ClientModel" Version="1.14.0" />
        <PackageReference Include="Meridian.Tandem" Version="$(TandemVersion)" />
        <PackageReference Include="Meridian.Tandem.Advanced" Version="$(TandemVersion)" />
        <PackageReference Include="Meridian.Tandem.Ledger" Version="$(TandemVersion)" />
        <PackageReference Include="Meridian.Tandem.OpenAICompatible" Version="$(TandemVersion)" />
        <PackageReference Include="Meridian.Tandem.Terminal" Version="$(TandemVersion)" />
    </ItemGroup>
</Project>
