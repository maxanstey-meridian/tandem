{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "enabled": true,
    "groups": [
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"]
    ],
    "newlinesBetween": false,
    "order": "asc",
    "ignoreCase": true
  },
  "ignorePatterns": [
    ".runtime-publish/**",
    "bridge/bin/**",
    "bridge/obj/**",
    "bridge/out/**",
    "bridge-tests/bin/**",
    "bridge-tests/obj/**",
    "node_modules/**",
    "packages/runtime-darwin-arm64/runtime/**",
    "packages/sdk/dist/**",
    "sample/dist/**",
    "pnpm-lock.yaml"
  ]
}
